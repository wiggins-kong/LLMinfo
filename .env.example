# ---------------------------------------------------------------------------
# LLMinfo environment
#
# Copy to .env and fill in real values before `docker compose up -d`.
# ---------------------------------------------------------------------------

# Public URL of the deployment. SakuraFrp terminates TLS at its edge, so this
# must be the https:// address users actually type. Used for trusted origins,
# cookie security and auth callbacks.
APP_URL=https://your-tunnel.example.com

# Where the SQLite database and cached provider logos are written.
# In Docker this is the mounted volume.
DATA_DIR=/data

# Secret used to sign sessions. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# First-boot administrator. These are only read when the database has no user
# yet; changing them later will NOT change the existing password.
# Password must be at least 12 characters.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# How often the server re-checks models.dev. A conditional request that
# returns 304 costs no bandwidth, so an hour is cheap.
SYNC_INTERVAL_MINUTES=60

# Number of trusted proxy hops in front of the app.
#   1 = SakuraFrp only (the default). The real client IP is read from the LAST
#       entry of X-Forwarded-For, because frpc appends it and the leading
#       entries are attacker-controlled.
#   2 = Cloudflare in front of SakuraFrp. See README for the extra handling
#       that case requires.
TRUST_PROXY_DEPTH=1
